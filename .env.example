# AI 故事轉遊戲資料：使用「本機 Claude Code CLI」（headless 模式），不需要 API key。
# 本專案「不一定要有 AI」：未設定或找不到 CLI 時，生成功能會明確退回 demo fixture，
# 也可以直接在 Studio 編輯或匯入 GameProject JSON。

# 啟用的 AI provider：claude-code | none
AI_PROVIDER=claude-code
# claude 執行檔路徑（不在 PATH 時必填，例如 VSCode 擴充套件內建的 native-binary/claude）
CLAUDE_CLI_PATH=claude
# 可選：指定模型（留空則使用 Claude Code 預設）
CLAUDE_MODEL=
# 單次生成逾時（毫秒）
CLAUDE_TIMEOUT_MS=240000


# 遠端模式：讓 AI agent 操作線上的 Studio 後台（token 在 Studio「AI 協作」產生，不要提交到 git）
STUDIO_URL=https://ai-rpg-studio.<你的子網域>.workers.dev
STUDIO_TOKEN=
