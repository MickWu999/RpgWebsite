{
  "schemaVersion": "2.0",
  "id": "demo-lantern",
  "title": "迷霧森林的燈火",
  "description": "守望燈塔熄滅了三夜，迷霧從東邊森林湧進燈火村。找到星光燈芯，決定它的歸屬。",
  "genre": "fantasy",
  "intro": "燈火村靠著山丘上的守望燈塔，熬過了一百個起霧的冬天。\n\n直到三天前，燈塔熄了。\n\n迷霧一夜比一夜更靠近村子。",
  "cover": {
    "tagline": "燈芯該歸誰，由你決定。"
  },
  "system": {
    "start": {
      "mapId": "start",
      "x": 6,
      "y": 9,
      "direction": "up"
    },
    "playerActorId": "player",
    "initialItems": []
  },
  "actors": [
    {
      "id": "player",
      "name": "艾琳",
      "profile": "村裡最會走夜路的年輕人，不信鬼神，但很信承諾。",
      "spriteAssetId": "char_hero"
    },
    {
      "id": "elder",
      "name": "村長莫倫",
      "profile": "想要：讓燈塔重新亮起。秘密：燈芯當年是他父親從森林古樹裡取走的。說話慢、愛用「孩子」稱呼人。",
      "spriteAssetId": "char_wizard",
      "voice": {
        "pitch": "low",
        "speed": "slow",
        "timbre": "soft"
      }
    },
    {
      "id": "karl",
      "name": "守林人卡爾",
      "profile": "想要：森林不再被村子索取。說話短、不客套。",
      "spriteAssetId": "char_ranger",
      "voice": {
        "pitch": "low",
        "speed": "normal",
        "timbre": "buzzy"
      }
    },
    {
      "id": "hoa",
      "name": "小禾",
      "profile": "怕黑的孩子，每晚數燈塔亮幾下才敢睡。",
      "spriteAssetId": "char_youth",
      "voice": {
        "pitch": "high",
        "speed": "fast",
        "timbre": "bright"
      }
    }
  ],
  "items": [
    {
      "id": "old_key",
      "name": "生鏽的鑰匙",
      "description": "柄上刻著一片葉子，是守林人的記號。",
      "iconAssetId": "icon_key"
    },
    {
      "id": "wick",
      "name": "星光燈芯",
      "description": "握在手裡會微微發熱，像一顆睡著的星星。",
      "iconAssetId": "icon_potion_blue"
    }
  ],
  "quests": [
    {
      "id": "q_main",
      "title": "熄滅的燈塔",
      "description": "村長說，燈塔需要新的星光燈芯。",
      "steps": [
        {
          "text": "到東邊的迷霧森林，找守林人卡爾"
        },
        {
          "text": "找到打開古樹的方法"
        },
        {
          "text": "把星光燈芯帶回去給村長"
        },
        {
          "text": "把燈芯放回森林的古樹"
        }
      ]
    }
  ],
  "endings": [
    {
      "id": "end_light",
      "title": "燈火重燃",
      "text": "星光燈芯在燈塔頂端亮起，迷霧像退潮一樣離開了燈火村。村民們在廣場上點起火堆，一直唱到天亮。",
      "mood": "triumphant",
      "epilogues": [
        {
          "condition": {
            "type": "switch",
            "id": "karl_upset",
            "value": true
          },
          "text": "卡爾從此不再踏進村子。有人說，起霧的夜裡會看見他站在森林邊，望著燈塔。"
        },
        {
          "condition": {
            "type": "switch",
            "id": "karl_upset",
            "value": false
          },
          "text": "卡爾在森林邊點了一盞小燈。每到起霧的夜晚，兩道光會隔著田野互相閃一下。"
        },
        {
          "condition": {
            "type": "switch",
            "id": "comforted_hoa",
            "value": true
          },
          "text": "小禾不再數燈塔了。她現在會數星星，說那是燈塔的朋友。"
        }
      ]
    },
    {
      "id": "end_forest",
      "title": "森林的心",
      "text": "燈芯回到古樹的根間，森林深處亮起一片溫柔的光。燈塔沒有再亮，但迷霧再也沒有越過田野。",
      "mood": "bittersweet",
      "epilogues": [
        {
          "condition": {
            "type": "switch",
            "id": "karl_upset",
            "value": true
          },
          "text": "卡爾很久之後才承認，他沒想過村子裡的人會做這樣的選擇。"
        },
        {
          "condition": {
            "type": "switch",
            "id": "comforted_hoa",
            "value": true
          },
          "text": "小禾學會了在黑暗裡唱歌。她說，只要有人陪著，黑也沒那麼可怕。"
        },
        {
          "condition": {
            "type": "switch",
            "id": "comforted_hoa",
            "value": false
          },
          "text": "小禾還是怕黑，但她開始提著自己的小燈，走到森林邊去看那片光。"
        }
      ]
    }
  ],
  "chapters": [
    {
