  "npcs": [
    {
      "id": "npc_elder",
      "name": "村長艾琳",
      "description": "守護燈火村多年的村長，總是站在燈塔旁。",
      "sceneId": "village",
      "position": {
        "x": 12,
        "y": 3
      },
