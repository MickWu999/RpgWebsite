                  "code": "text",
                  "text": "你……要把它還回來？",
                  "actorId": "karl"
                },
                {
                  "code": "text",
                  "text": "我守了這片森林二十年，第一次有人這樣做。",
                  "actorId": "karl"
                }
              ]
            }
