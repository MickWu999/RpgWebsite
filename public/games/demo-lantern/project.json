    {
      "id": "npc_karl",
      "name": "守林人卡爾",
      "description": "獨自住在迷霧森林裡的守林人，對外人很警戒。",
      "sceneId": "forest",
      "position": {
        "x": 4,
        "y": 5
      },
      "spriteAssetId": "char_ranger",
      "dialogueNodeId": "karl_idle",
      "dialogueVariants": [
        {
          "condition": {
            "type": "flag_equals",
            "flag": "karl_told",
            "value": true
          },
          "dialogueNodeId": "karl_after"
        },
        {
          "condition": {
            "type": "quest_active",
            "questId": "q_main"
          },
          "dialogueNodeId": "karl_intro"
        }
      ],
      "questIds": [
        "q_main"
      ],
      "voice": {
        "pitch": "low",
        "speed": "normal",
        "timbre": "buzzy"
      }
    }
  ],
  "dialogues": [
    {
      "id": "elder_intro",
      "speaker": "村長艾琳",
      "text": "旅人，你來得正好。守望燈塔已經熄滅三夜，迷霧正從東邊的森林湧進村子。",
      "choices": [
        {
          "id": "c_accept",
          "text": "我來幫忙重新點燃燈塔。",
          "nextNodeId": "elder_accept",
          "effects": [
            {
              "type": "set_flag",
              "flag": "quest_accepted",
              "value": true
            }
          ]
        },
        {
          "id": "c_ask",
          "text": "燈塔為什麼會熄滅？",
          "nextNodeId": "elder_lore"
        },
        {
          "id": "c_leave",
          "text": "我再想想。"
        }
      ]
    },
    {
      "id": "elder_lore",
      "speaker": "村長艾琳",
      "text": "燈塔靠一枚「星光燈芯」發光。三天前它被迷霧帶走，落進了森林深處。",
      "choices": [
        {
          "id": "c_accept_after_lore",
          "text": "我明白了，我去把燈芯找回來。",
          "nextNodeId": "elder_accept",
          "effects": [
            {
              "type": "set_flag",
              "flag": "quest_accepted",
              "value": true
            }
          ]
        },
        {
          "id": "c_leave_after_lore",
          "text": "聽起來很危險，我先離開。"
        }
      ]
    },
    {
      "id": "elder_accept",
      "speaker": "村長艾琳",
      "text": "謝謝你！往東走就是迷霧森林，去找守林人卡爾，他知道燈芯的下落。找到之後回到燈塔下來見我。"
    },
    {
      "id": "elder_waiting",
      "speaker": "村長艾琳",
      "text": "卡爾住在東邊的森林裡。拿到星光燈芯後，回到燈塔下來見我。"
    },
    {
      "id": "elder_final",
      "speaker": "村長艾琳",
      "text": "你真的帶回了星光燈芯……卡爾託你轉告，森林失去它也會枯萎。這枚燈芯該歸誰，由你決定。",
      "choices": [
        {
          "id": "c_light",
          "text": "交給艾琳，重新點燃守望燈塔。",
          "effects": [
            {
              "type": "remove_item",
              "itemId": "item_wick"
            },
            {
              "type": "set_flag",
              "flag": "ending_choice",
              "value": "light"
            },
            {
              "type": "add_xp",
              "amount": 50
            }
          ]
        },
        {
          "id": "c_forest",
          "text": "把燈芯還給森林，請卡爾用它平息迷霧。",
          "effects": [
            {
              "type": "remove_item",
              "itemId": "item_wick"
            },
            {
              "type": "set_flag",
              "flag": "ending_choice",
              "value": "forest"
            },
            {
              "type": "add_xp",
              "amount": 50
            }
          ]
        }
      ]
    },
    {
      "id": "karl_idle",
      "speaker": "守林人卡爾",
      "text": "這片森林不歡迎閒逛的人。沒事的話就回村子去吧。"
    },
    {
      "id": "karl_intro",
      "speaker": "守林人卡爾",
      "text": "艾琳派你來的？星光燈芯是森林的心臟。告訴我，你拿走它之後打算怎麼做？",
      "choices": [
        {
          "id": "c_karl_promise",
          "text": "我會尊重森林，絕不濫用它的力量。",
          "nextNodeId": "karl_hint",
          "effects": [
            {
              "type": "set_flag",
              "flag": "karl_told",
              "value": true
            }
          ]
        },
        {
          "id": "c_karl_rude",
          "text": "那不關你的事。",
          "nextNodeId": "karl_rude"
        }
      ]
    },
    {
      "id": "karl_rude",
      "speaker": "守林人卡爾",
      "text": "……那你就自己在迷霧裡打轉吧。",
      "choices": [
        {
          "id": "c_karl_retry",
          "text": "抱歉，請讓我重新回答。",
          "nextNodeId": "karl_intro"
        },
        {
          "id": "c_karl_go",
          "text": "（轉身離開）"
        }
      ]
    },
    {
      "id": "karl_hint",
      "speaker": "守林人卡爾",
      "text": "好。燈芯落在森林東南角的古樹根下，現在它會為你發光。記住你的承諾。"
    },
    {
      "id": "karl_after",
      "speaker": "守林人卡爾",
      "text": "燈芯在東南角的古樹根下。記住你的承諾，旅人。"
    },
    {
      "id": "obj_lighthouse_locked",
      "speaker": "守望燈塔",
      "text": "燈塔一片漆黑，門上貼著一張告示：「燈芯遺失，路過的旅人請洽村長艾琳。」"
    },
    {
      "id": "obj_lighthouse_empty",
      "speaker": "守望燈塔",
      "text": "燈座空蕩蕩的。少了星光燈芯，這座燈塔什麼也點不亮。卡爾應該在東邊的森林裡。"
    },
    {
      "id": "obj_lighthouse_wick",
      "speaker": "守望燈塔",
      "text": "懷裡的星光燈芯微微發亮，像是在回應燈塔。該把它交給艾琳，由你決定它的去向了。"
    },
    {
      "id": "obj_sign",
      "speaker": "告示牌",
      "text": "「往東——迷霧森林。守林人卡爾住在林中，非請勿入。」"
    },
    {
      "id": "obj_sign_hint",
      "speaker": "告示牌",
      "text": "告示牌下方多了一行潦草的字：「東南角古樹下，有光。」看起來像是卡爾的筆跡。"
    },
    {
      "id": "obj_house",
      "speaker": "民宅的門",
      "text": "門鎖得緊緊的。屋裡傳來幾聲咳嗽，村民們都躲在家裡，避開越來越濃的迷霧。"
    },
    {
      "id": "obj_well",
      "speaker": "古井",
      "text": "井水清澈見底。井邊的石頭上刻著一行舊字：「燈火與森林，本是同一條根。」"
    },
    {
      "id": "obj_tree_fog",
      "speaker": "古樹",
      "text": "一棵巨大的古樹，樹根盤根錯節，像是藏著什麼。但迷霧太濃，什麼也看不清楚。"
    },
    {
      "id": "obj_tree_glow",
      "speaker": "古樹",
      "text": "古樹的根部透出淡淡的星光——燈芯就在這附近！"
    }
  ],
  "quests": [
    {
      "id": "q_main",
      "title": "重燃守望燈塔",
      "description": "找回星光燈芯，並決定它的歸屬。",
      "startCondition": {
        "type": "flag_equals",
        "flag": "quest_accepted",
        "value": true
      },
      "objectives": [
        {
          "id": "o_meet_karl",
          "type": "talk_to_npc",
          "targetId": "npc_karl",
          "description": "到東邊的迷霧森林找守林人卡爾"
        },
        {
          "id": "o_promise",
          "type": "make_choice",
          "targetId": "c_karl_promise",
          "description": "向卡爾承諾會尊重森林"
        },
