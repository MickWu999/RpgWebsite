              "trigger": "action",
              "priority": "same",
              "commands": [
                {
                  "code": "text",
                  "text": "村裡的人？霧這麼濃還敢進來。",
                  "actorId": "karl"
                },
                {
                  "code": "text",
                  "text": "……村長叫你來的吧。回去吧，這裡沒有你們要的東西。",
                  "actorId": "karl"
                }
              ]
            },
            {
              "conditions": {
                "switches": [
                  "talked_elder"
                ]
              },
              "graphic": {
                "assetId": "char_ranger"
              },
              "trigger": "action",
              "priority": "same",
              "commands": [
                {
                  "code": "text",
                  "text": "燈芯？哼。你們拿走過一次了。",
                  "actorId": "karl"
                },
                {
                  "code": "text",
                  "text": "那是古樹的心。當年你們村長的父親把它挖走，森林才開始起霧。",
                  "actorId": "karl"
                },
                {
                  "code": "text",
                  "text": "鑰匙在那個箱子裡，我不攔你。只是你要想清楚，光是誰的。",
                  "actorId": "karl"
                },
                {
                  "code": "choices",
                  "options": [
                    {
                      "text": "我會想清楚再決定。",
                      "commands": [
                        {
                          "code": "text",
                          "text": "……至少你願意想。",
                          "actorId": "karl"
                        },
                        {
                          "code": "switch",
                          "ids": [
                            "karl_told"
                          ],
                          "value": true
                        },
                        {
                          "code": "quest",
                          "questId": "q_main",
                          "action": "step",
                          "step": 1
                        }
                      ]
                    },
                    {
                      "text": "村子快被霧吞掉了，我沒得選。",
                      "commands": [
                        {
                          "code": "text",
                          "text": "每個拿走東西的人都這麼說。",
                          "actorId": "karl"
                        },
                        {
                          "code": "switch",
                          "ids": [
                            "karl_told",
                            "karl_upset"
                          ],
                          "value": true
                        },
                        {
                          "code": "quest",
                          "questId": "q_main",
                          "action": "step",
                          "step": 1
                        }
                      ]
                    }
                  ]
                }
