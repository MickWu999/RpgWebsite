                    "type": "switch",
                    "id": "karl_upset",
                    "value": true
                  },
                  "then": [
                    {
                      "code": "text",
                      "text": "你決定了就去吧。別在我面前拿著它。",
                      "actorId": "karl"
                    }
                  ],
                  "else": [
                    {
                      "code": "text",
                      "text": "箱子在東邊，古樹在更裡面。慢慢走，霧會讓人迷路。",
                      "actorId": "karl"
                    }
                  ]
                }
              ]
            },
            {
              "conditions": {
                "switches": [
                  "return_wick"
