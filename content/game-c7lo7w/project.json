  "quests": [
    {
      "id": "q_letter",
      "title": "取貨櫃上的包裹",
      "description": "店長交代：取貨櫃上那個寄給他的包裹很重要，他早上自己來拿。",
      "steps": [
        {
          "text": "找出十二點前拿走包裹的人。「仔細問」會花掉一個時段（十點 → 十一點 → 十二點），先想好要問誰"
        },
        {
          "text": "夜晚又重來了。上一輪問到的事都在筆記裡（選單的「物品」），這一輪先問還沒問的人"
        },
        {
          "text": "有人說了謊。找到證據，跟那個人對質"
        }
      ]
    }
  ],
  "endings": [
    {
      "id": "end_hand",
      "title": "她自己交給他",
      "text": "時鐘走過了十二點。這一次，夜晚沒有重來。\n早上七點，店長走進來的時候，芷妤已經在門口等著了。她手上抱著那個包裹。\n（試玩版到這裡結束）",
      "mood": "bittersweet",
      "epilogues": [
        {
          "condition": {
            "type": "variable",
            "id": "loop",
            "op": "<=",
            "value": 1
          },
          "text": "這個夜晚只重來了一次。小周有點得意，又有點可惜。"
        },
        {
          "condition": {
            "type": "variable",
            "id": "loop",
            "op": ">=",
            "value": 2
          },
          "text": "這個夜晚重來了好幾次。小周把每一輪的筆記，都留在了收銀機旁邊。"
        }
      ]
    },
    {
      "id": "end_back",
      "title": "放回取貨櫃",
      "text": "時鐘走過了十二點。這一次，夜晚沒有重來。\n包裹回到了取貨櫃上。早上店長來取件的時候，看著寄件人的名字看了很久，然後問小周：「昨晚，有誰來過嗎？」\n（試玩版到這裡結束）",
      "mood": "mysterious",
      "epilogues": [
        {
          "condition": {
