  "quests": [
    {
      "id": "q_letter",
      "title": "收銀機下面的信",
      "description": "店長交代：收銀機下面那封信，明天早上有人會來拿，誰都不准碰。",
      "steps": [
        {
          "text": "顧好收銀機下面的信，撐到十二點"
        },
        {
          "text": "信在十二點前不見了，時間又回到十點。「仔細問」會花掉一個時段，想清楚先問誰"
        },
        {
          "text": "有人說了謊。找到證據，跟那個人對質"
        }
      ]
    }
  ],
  "endings": [
    {
      "id": "end_hand",
      "title": "她自己交給他",
      "text": "時鐘走過了十二點。這一次，夜晚沒有重來。\n早上七點，店長走進來的時候，芷妤已經在門口等著了。她手上拿著那封信。\n（試玩版到這裡結束）",
      "mood": "bittersweet",
      "epilogues": [
        {
          "condition": {
            "type": "variable",
            "id": "loop",
            "op": "<=",
            "value": 1
          },
          "text": "這個夜晚只重來了一次。小周有點得意，又有點可惜。"
        },
        {
          "condition": {
            "type": "variable",
            "id": "loop",
            "op": ">=",
            "value": 2
          },
          "text": "這個夜晚重來了好幾次。小周把每一輪的筆記，都留在了收銀機旁邊。"
        }
      ]
    },
    {
      "id": "end_back",
      "title": "放回收銀機",
      "text": "時鐘走過了十二點。這一次，夜晚沒有重來。\n信回到了收銀機下面。早上店長來拿信的時候，看了很久，然後問小周：「昨晚，有誰來過嗎？」\n（試玩版到這裡結束）",
      "mood": "mysterious",
