                  "code": "text",
                  "text": "（芷妤戴著耳機寫作業。桌上放著一杯喝了一半的奶茶。）"
                },
                {
                  "code": "choices",
                  "options": [
                    {
                      "text": "聊兩句。",
                      "commands": [
                        {
                          "code": "text",
                          "text": "……我在寫作業。",
                          "actorId": "yu"
                        },
                        {
                          "code": "if",
                          "condition": {
                            "type": "variable",
                            "id": "loop",
                            "op": ">=",
                            "value": 1
                          },
                          "then": [
                            {
                              "code": "text",
                              "text": "（這句話，小周已經聽過了。一字不差。）"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "仔細問她（花掉一個時段）",
                      "condition": {
                        "type": "switch",
                        "id": "k_yu",
                        "value": false
                      },
                      "commands": [
                        {
                          "code": "text",
                          "text": "我一直坐在這裡。戴著耳機，什麼都沒聽到。我沒離開過座位。",
                          "actorId": "yu"
                        },
                        {
                          "code": "item",
                          "itemId": "note_yu",
                          "delta": 1
                        },
                        {
                          "code": "switch",
                          "ids": [
                            "k_yu"
                          ],
                          "value": true
                        },
                        {
                          "code": "time",
                          "advance": 1
                        }
                      ]
                    },
                    {
                      "text": "妳說謊。",
                      "commands": [
                        {
                          "code": "text",
                          "text": "……證據呢？",
                          "actorId": "yu"
                        },
                        {
                          "code": "present",
                          "options": [
                            {
                              "itemId": "note_kai",
                              "commands": [
                                {
                                  "code": "text",
                                  "text": "阿凱看到妳十一點走去櫃檯，在看收銀機下面。",
                                  "actorId": "player"
                                },
                                {
                                  "code": "switch",
                                  "ids": [
                                    "solved"
                                  ],
                                  "value": true
                                }
                              ]
                            },
                            {
                              "itemId": "note_ring",
                              "commands": [
                                {
                                  "code": "text",
                                  "text": "十一點，櫃檯上有一圈水痕。跟妳那杯奶茶的杯底一樣大。",
                                  "actorId": "player"
                                },
                                {
                                  "code": "switch",
                                  "ids": [
                                    "solved"
                                  ],
                                  "value": true
                                }
                              ]
                            }
                          ],
                          "otherwise": [
                            {
                              "code": "text",
                              "text": "……那又怎樣？那跟我有什麼關係。",
                              "actorId": "yu"
                            },
                            {
                              "code": "text",
                              "text": "（芷妤把耳機戴回去。拿錯東西了。）"
                            }
                          ],
                          "cancel": [
                            {
                              "code": "text",
                              "text": "沒證據就別亂說。",
                              "actorId": "yu"
                            }
                          ]
                        },
                        {
                          "code": "if",
                          "condition": {
                            "type": "switch",
                            "id": "solved",
                            "value": true
                          },
                          "then": [
                            {
                              "code": "text",
                              "text": "（芷妤拿下耳機，沉默了很久。）"
                            },
                            {
                              "code": "text",
                              "text": "……信是我寫的。用我媽的名字。",
                              "actorId": "yu"
                            },
                            {
                              "code": "text",
                              "text": "店長是我爸。我只見過他的照片。我想知道，他收到「她」的信，會不會來。",
                              "actorId": "yu"
                            },
                            {
                              "code": "text",
                              "text": "可是寫完我就後悔了。所以每天晚上，都想把它拿回來。",
                              "actorId": "yu"
                            },
                            {
                              "code": "quest",
                              "questId": "q_letter",
                              "action": "complete"
                            },
                            {
                              "code": "choices",
                              "options": [
                                {
                                  "text": "信還給妳。妳自己交給他。",
                                  "commands": [
                                    {
                                      "code": "text",
                                      "text": "……我自己交給他？",
                                      "actorId": "yu"
                                    },
                                    {
                                      "code": "text",
                                      "text": "嗯。用妳自己的名字。",
                                      "actorId": "player"
                                    },
                                    {
                                      "code": "ending",
                                      "endingId": "end_hand"
                                    }
                                  ]
                                },
                                {
                                  "text": "放回收銀機。讓店長自己決定。",
                                  "commands": [
                                    {
                                      "code": "text",
                                      "text": "……好。（她把信放回收銀機下面，手在發抖。）",
                                      "actorId": "yu"
                                    },
                                    {
                                      "code": "ending",
                                      "endingId": "end_back"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
