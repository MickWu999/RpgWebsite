{
  "name": "ai-rpg-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/build-catalog.ts && next dev -p 3000",
    "build": "tsx scripts/build-catalog.ts && next build",
    "start": "npx serve@14 out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "ai": "tsx scripts/ai-server.ts",
    "generate": "tsx scripts/generate.ts",
    "validate": "tsx scripts/validate.ts",
    "review": "tsx scripts/review.ts",
    "catalog": "tsx scripts/build-catalog.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "next": "^16.4.2",
    "nipplejs": "^1.0.4",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "wrangler": "^4.151.3"
  }
}
