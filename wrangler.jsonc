{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 前台（玩家版）：靜態網站＋讀取已發布遊戲的小型 Worker（npm run deploy）
  // 後台（Studio）：env.studio，獨立的 Worker 與網址，需要登入（npm run deploy:studio）
  "name": "ai-rpg-builder",
  "main": "worker/player.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/games/*", "/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-rpg-studio", "database_id": "53669d11-85be-4b33-bcd1-36b453677aed", "migrations_dir": "migrations" }
  ],
  "env": {
    "studio": {
      "name": "ai-rpg-studio",
      "main": "worker/studio.ts",
      "assets": {
        "directory": "./out",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*", "/"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "ai-rpg-studio", "database_id": "53669d11-85be-4b33-bcd1-36b453677aed", "migrations_dir": "migrations" }
      ]
    }
  }
}
